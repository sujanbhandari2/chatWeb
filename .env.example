VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

VITE_WIDGET_ACCESS_KEY=

# Vitafy chat: `accessKey:secretKey` for `/api/v1/chat/*` (sent as `X-Api-Key`) and Socket.IO handshake.
# Prefer `VITE_WIDGET_API_KEY`; `VITE_WIDGET_ACCESS_KEY` and `VITE_CHAT_API_KEY` are also supported.
# VITE_WIDGET_API_KEY=accessKey:secretKey

# Optional widget preset: development | staging | production | custom | dark | brand | full
# (omit → MODE-based profile; see docs/ENVIRONMENT.md)
# VITE_WIDGET_PROFILE=

# Set automatically from package.json version at build (vite.config.ts); optional override in .env.local
# VITE_APP_VERSION=
