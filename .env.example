VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

VITE_WIDGET_ACCESS_KEY=

# Vitafy chat: `accessKey:secretKey` for `/api/v1/chat/*` (`X-Api-Key`) and Socket.IO handshake (`auth.apiKey`).
# Realtime and REST chat routes both use this variable only.

# Optional widget preset: development | staging | production | custom | dark | brand | full
# (omit → MODE-based profile; see docs/ENVIRONMENT.md)
# VITE_WIDGET_PROFILE=

# Set automatically from package.json version at build (vite.config.ts); optional override in .env.local
# VITE_APP_VERSION=
