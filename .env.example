VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Widget embed credential: axios sends X-Api-Key as the merged id:secret (or a single string from this env; see docs/WIDGET_WEBSITE.md).
# You may set only VITE_WIDGET_ACCESS_KEY if it already contains "id:secret", or set both halves separately.
# VITE_WIDGET_ACCESS_KEY=
# VITE_WIDGET_SECRET_KEY=

# Optional company id for widget.html (X-Company-Id). Legacy env name still supported: VITE_WIDGET_TENANT_ID.
# VITE_WIDGET_COMPANY_ID=

# Optional widget preset: development | staging | production | custom | dark | brand | full
# (omit → MODE-based profile; see docs/ENVIRONMENT.md)
# VITE_WIDGET_PROFILE=

# Set automatically from package.json version at build (vite.config.ts); optional override in .env.local
# VITE_APP_VERSION=
